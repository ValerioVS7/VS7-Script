#include <cronus.gph>

// ========== DEFINIZIONI PROFILI ==========
#define PROFILE_MICHAEL     0   // Bullet Time - Slow & Focus
#define PROFILE_FRANKLIN    1   // Driving Focus - Fast Track
#define PROFILE_TREVOR      2   // Red Mist - Aggro & Rage
#define PROFILE_SNIPER      3   // Precision - One Shot Wonder
#define PROFILE_BALANCED    4   // Hybrid - All-rounder

// ========== DEFINIZIONI DISPLAY ==========
#define DISPLAY_WIDTH       128
#define DISPLAY_HEIGHT      64
#define MENU_OFF            0
#define MENU_MAIN           1
#define MENU_AIM_ASSIST     2
#define MENU_PROFILES       3

// ========== SHAPE ASSIST ==========
#define SHAPE_CIRCLE        0
#define SHAPE_TRIANGLE      1
#define SHAPE_SPIRAL        2

// ========== VARIABILI GLOBALI - PROFILI ==========
int current_profile = PROFILE_BALANCED;
int profile_saved = PROFILE_BALANCED;

// Profile Names
char profile_names[5][16] = {
    "MICHAEL",
    "FRANKLIN",
    "TREVOR",
    "SNIPER",
    "BALANCED"
};

// Profile Characteristics
int profile_aim_assist_min[5]   = {98, 95, 100, 98, 99};
int profile_aim_assist_max[5]   = {100, 99, 105, 98, 99};
int profile_delay_min[5]        = {40, 20, 10, 200, 50};
int profile_delay_max[5]        = {50, 30, 15, 300, 70};
int profile_vibration_low[5]    = {30, 50, 80, 20, 40};
int profile_vibration_high[5]   = {50, 80, 100, 30, 60};
int profile_triple_shots[5]     = {3, 3, 6, 1, 3};

// ========== VARIABILI GLOBALI - AIM ASSIST ==========
int aim_assist_enabled = TRUE;
int aim_assist_active = FALSE;
int current_shape = SHAPE_CIRCLE;
int intensity = 30;
int speed = 2;
int angle = 0;

// ========== VARIABILI GLOBALI - MENU ==========
int current_menu = MENU_OFF;
int menu_selection = 0;
int menu_visible = FALSE;
int menu_toggle_time = 0;
int selection_change_time = 0;

// ========== VARIABILI GLOBALI - ANIMAZIONE ==========
int animation_frame = 0;
int animation_timer = 0;
int flash_intensity = 100;
int flash_direction = -5;
int animation_active = TRUE;

// ========== VARIABILI GLOBALI - VIBRAZIONE ==========
int vibration_active = TRUE;
int current_vibration = 0;
int vibration_timer = 0;
int target_distance = 50;
int enemy_movement_speed = 0;

// ========== VARIABILI GLOBALI - COLORI LED ==========
int current_color = 0;
int color_timer = 0;

// ========== VARIABILI GLOBALI - DISPLAY ==========
int display_refresh_time = 0;
int display_needs_update = TRUE;
int cursor_blink_time = 0;
int cursor_visible = TRUE;

// ========== ARRAY - VALERIO 3D ART ==========
const string VALERIO_3D_TOP     = "╔═ VALERIO ═╗";
const string VALERIO_3D_MID1    = "║ ◇◆◇◆◇◆◇ ║";
const string VALERIO_3D_MID2    = "║ ⚡💥⚡💥⚡ ║";
const string VALERIO_3D_MID3    = "║ ◆◇◆◇◆◇◆ ║";
const string VALERIO_3D_BOT     = "╚═════════╝";

// ========== INIT ==========
init {
    profile_saved = get_pvar(SPVAR_1, 0, 4, PROFILE_BALANCED);
    current_profile = profile_saved;
    animation_active = TRUE;
    vibration_active = TRUE;
}

// ========== MAIN LOOP ==========
main {
    if(event_press(PS4_OPTIONS)) {
        menu_visible = !menu_visible;
        if(menu_visible) {
            current_menu = MENU_MAIN;
            menu_selection = 0;
        } else {
            current_menu = MENU_OFF;
        }
        display_needs_update = TRUE;
    }
    
    if(event_press(PS4_DOWN) && !menu_visible) {
        current_profile = (current_profile + 1) % 5;
        set_pvar(SPVAR_1, current_profile);
        combo_run(profile_changed_feedback);
        display_needs_update = TRUE;
    }
    
    if(event_press(PS4_UP) && !menu_visible) {
        current_profile = (current_profile - 1 + 5) % 5;
        set_pvar(SPVAR_1, current_profile);
        combo_run(profile_changed_feedback);
        display_needs_update = TRUE;
    }
    
    if(menu_visible) {
        handle_menu_navigation();
    } else {
        if(get_val(PS4_R2) > 50) {
            combo_run(activate_aim_assist);
        }
        handle_continuous_vibration();
    }
    
    update_animation();
    
    if(display_needs_update || display_refresh_time > 100) {
        update_display();
        display_refresh_time = 0;
        display_needs_update = FALSE;
    }
    
    menu_toggle_time += get_rtime();
    display_refresh_time += get_rtime();
    selection_change_time += get_rtime();
    animation_timer += get_rtime();
    vibration_timer += get_rtime();
    color_timer += get_rtime();
}

// ========== COMBO: ACTIVATE AIM ASSIST ==========
combo activate_aim_assist {
    int shots_fired = 0;
    int current_delay;
    int max_shots = profile_triple_shots[current_profile];
    
    while(get_val(PS4_R2) > 50 && shots_fired < max_shots) {
        current_delay = calculate_adaptive_delay();
        apply_aim_assist_profile();
        
        set_val(PS4_R2, 100);
        wait(10);
        set_val(PS4_R2, 0);
        
        wait(current_delay);
        shots_fired++;
        
        combo_run(vibration_shot_feedback);
    }
}

// ========== COMBO: PROFILE CHANGED FEEDBACK ==========
combo profile_changed_feedback {
    rumble(0, profile_vibration_high[current_profile], 200);
    wait(100);
    rumble(0, profile_vibration_low[current_profile], 200);
    wait(50);
    
    set_led(LED_1, current_profile == PROFILE_MICHAEL);
    set_led(LED_2, current_profile == PROFILE_FRANKLIN);
    set_led(LED_3, current_profile == PROFILE_TREVOR);
    wait(300);
    set_led(LED_1, 0);
    set_led(LED_2, 0);
    set_led(LED_3, 0);
}

// ========== COMBO: VIBRATION SHOT FEEDBACK ==========
combo vibration_shot_feedback {
    rumble(0, 60, 50);
    wait(50);
    rumble(0, 0, 0);
}

// ========== FUNZIONE: APPLY AIM ASSIST PROFILE ==========
void apply_aim_assist_profile() {
    int stick_x = 0;
    int stick_y = 0;
    int aim_value = profile_aim_assist_min[current_profile];
    
    if(current_shape == SHAPE_CIRCLE) {
        stick_x = (aim_value * custom_cos(angle)) / 100;
        stick_y = (aim_value * custom_sin(angle)) / 100;
        angle = (angle + speed) % 360;
    }
    
    set_val(PS4_RX, clamp(get_val(PS4_RX) + stick_x, -100, 100));
    set_val(PS4_RY, clamp(get_val(PS4_RY) + stick_y, -100, 100));
}

// ========== FUNZIONE: CALCULATE ADAPTIVE DELAY ==========
int calculate_adaptive_delay() {
    int delay;
    int delay_min = profile_delay_min[current_profile];
    int delay_max = profile_delay_max[current_profile];
    
    target_distance = abs(get_val(PS4_RX)) + abs(get_val(PS4_RY));
    
    if(target_distance > 70) {
        delay = delay_max;
    } else if(target_distance > 40) {
        delay = (delay_min + delay_max) / 2;
    } else {
        delay = delay_min;
    }
    
    return delay;
}

// ========== FUNZIONE: HANDLE CONTINUOUS VIBRATION ==========
void handle_continuous_vibration() {
    if(!vibration_active) return;
    
    if(vibration_timer > 100) {
        int vib_low = profile_vibration_low[current_profile];
        int vib_high = profile_vibration_high[current_profile];
        
        if((vibration_timer / 100) % 2 == 0) {
            rumble(0, vib_low, 100);
        } else {
            rumble(0, vib_high, 100);
        }
        
        vibration_timer = 0;
    }
}

// ========== FUNZIONE: UPDATE ANIMATION ==========
void update_animation() {
    if(!animation_active) return;
    
    if(animation_timer > 50) {
        flash_intensity += flash_direction;
        
        if(flash_intensity >= 100) {
            flash_direction = -5;
        } else if(flash_intensity <= 20) {
            flash_direction = 5;
        }
        
        animation_timer = 0;
        display_needs_update = TRUE;
    }
}

// ========== FUNZIONE: HANDLE MENU NAVIGATION ==========
void handle_menu_navigation() {
    if(event_press(PS4_UP) && selection_change_time > 150) {
        menu_selection = (menu_selection - 1 + 3) % 3;
        selection_change_time = 0;
        display_needs_update = TRUE;
    }
    
    if(event_press(PS4_DOWN) && selection_change_time > 150) {
        menu_selection = (menu_selection + 1) % 3;
        selection_change_time = 0;
        display_needs_update = TRUE;
    }
    
    if(event_press(PS4_CROSS) && selection_change_time > 200) {
        if(current_menu == MENU_MAIN) {
            current_menu = MENU_PROFILES;
            menu_selection = 0;
        }
        selection_change_time = 0;
        display_needs_update = TRUE;
    }
}

// ========== FUNZIONE: UPDATE DISPLAY ==========
void update_display() {
    cls_oled(0);
    
    if(!menu_visible) {
        draw_valerio_animation();
        draw_profile_info();
    } else {
        draw_menu();
    }
}

// ========== FUNZIONE: DRAW VALERIO ANIMATION ==========
void draw_valerio_animation() {
    int y_offset = 5;
    
    printf(8, y_offset, 1, VALERIO_3D_TOP);
    
    if((animation_frame / 10) % 2 == 0) {
        printf(12, y_offset + 12, 1, VALERIO_3D_MID1);
        printf(12, y_offset + 24, 1, VALERIO_3D_MID2);
    } else {
        printf(12, y_offset + 12, 1, VALERIO_3D_MID3);
        printf(12, y_offset + 24, 1, VALERIO_3D_MID1);
    }
    
    printf(8, y_offset + 36, 1, VALERIO_3D_BOT);
    
    animation_frame++;
}

// ========== FUNZIONE: DRAW PROFILE INFO ==========
void draw_profile_info() {
    printf(2, 50, 1, "Profile: %s", profile_names[current_profile]);
    printf(2, 58, 1, "D-Pad: Change | OPTION: Menu");
}

// ========== FUNZIONE: DRAW MENU ==========
void draw_menu() {
    rect_oled(0, 0, DISPLAY_WIDTH, 12, 1);
    printf(2, 2, 0, "MENU");
    
    if(current_menu == MENU_MAIN) {
        printf(10, 20, 1, "Profiles");
        printf(10, 32, 1, "Settings");
        printf(10, 44, 1, "About");
    } else if(current_menu == MENU_PROFILES) {
        for(int i = 0; i < 5; i++) {
            if(i == current_profile) {
                printf(2, 20 + (i * 8), 1, "> %s", profile_names[i]);
            } else {
                printf(2, 20 + (i * 8), 1, "  %s", profile_names[i]);
            }
        }
    }
    
    printf(2, 58, 1, "CROSS: Select | CIRCLE: Back");
}

// ========== MATH: CUSTOM SIN ==========
int custom_sin(int degrees) {
    int sine_table[91] = {
        0, 2, 3, 5, 7, 9, 10, 12, 14, 16, 17, 19, 21, 22, 24, 26, 28, 29, 31, 33,
        34, 36, 37, 39, 41, 42, 44, 45, 47, 48, 50, 52, 53, 54, 56, 57, 59, 60, 62, 63,
        64, 66, 67, 68, 69, 71, 72, 73, 74, 75, 76, 77, 78, 79, 80, 81, 82, 83, 84, 85,
        86, 87, 87, 88, 89, 90, 90, 91, 91, 92, 92, 93, 93, 94, 94, 94, 95, 95, 95, 96,
        96, 96, 96, 97, 97, 97, 97, 97, 98, 98, 98
    };
    
    degrees = degrees % 360;
    if(degrees < 0) degrees += 360;
    
    if(degrees <= 90) return sine_table[degrees];
    else if(degrees <= 180) return sine_table[180 - degrees];
    else if(degrees <= 270) return -sine_table[degrees - 180];
    else return -sine_table[360 - degrees];
}

// ========== MATH: CUSTOM COS ==========
int custom_cos(int degrees) {
    return custom_sin(degrees + 90);
}

// ========== UTILITY: CLAMP ==========
int clamp(int value, int min_val, int max_val) {
    if(value < min_val) return min_val;
    if(value > max_val) return max_val;
    return value;
}

// ========== UTILITY: ABS ==========
int abs(int value) {
    if(value < 0) return -value;
    return value;
}
